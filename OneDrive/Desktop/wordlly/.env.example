# Copy this file to .env and fill in your own values

# Local MongoDB:   mongodb://127.0.0.1:27017/wordly
# MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster>/wordly
MONGO_URI=mongodb://127.0.0.1:27017/wordly

# Port the Express server runs on
PORT=5000

# Optional — needed for AI features (generating tomorrow's words and
# grammar lessons on demand). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — defaults to claude-haiku-4-5-20251001 if not set
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
